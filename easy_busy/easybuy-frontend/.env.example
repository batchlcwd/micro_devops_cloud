# Base path for API calls. In dev, /gw is proxied by Vite to GATEWAY_URL.
# For a production build served from another origin, point this at the gateway
# (e.g. https://api.example.com) and enable CORS on the gateway.
VITE_API_BASE_URL=/gw

# Where the Vite dev proxy forwards /gw (dev server only)
GATEWAY_URL=http://localhost:8080

# Optional fallback Razorpay key id (rzp_live_… / rzp_test_…). payment-service normally
# returns the key id with each Razorpay order, so this is rarely needed. Never put the key secret here.
# VITE_RAZORPAY_KEY_ID=
