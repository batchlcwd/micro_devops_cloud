# API gateway base URL (Spring Cloud Gateway)
VITE_API_BASE_URL=http://localhost:8080

# true = use in-browser mock data (src/data); false = call the REST API
VITE_USE_MOCKS=true

# mock = in-app simulated checkout; razorpay = real Razorpay Checkout (checkout.js)
VITE_PAYMENT_GATEWAY=mock
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
